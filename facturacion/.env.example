DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

# Timeouts DB
DB_STATEMENT_TIMEOUT_MS=15000

ADMINER_PORT=

PORT=
NODE_ENV=development

# Si estás detrás de un reverse proxy (Nginx/Traefik/ALB)
TRUST_PROXY=false

# HTTP server timeouts (ms)
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_HEADERS_TIMEOUT_MS=35000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000

# JWT
# JWT_SECRET se usa para HS256 (fallback)
JWT_SECRET=
# JWT_PRIVATE_KEY y JWT_PUBLIC_KEY se usan para RS256 (Recomendado para prod)
# Generar con:
# ssh-keygen -t rsa -b 4096 -m PEM -f jwt.key
# openssl rsa -in jwt.key -pubout -outform PEM -out jwt.key.pub
# Pegar el contenido como una sola línea reemplazando los saltos con \n
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=15m

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=7

# Throttler global (valores en milisegundos)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Anti brute-force login (valores en milisegundos)
LOGIN_MAX_ATTEMPTS_EMAIL=10
LOGIN_MAX_ATTEMPTS_IP=30
LOGIN_ATTEMPT_WINDOW_MS=600000
LOGIN_ATTEMPT_BLOCK_MS=900000

# CORS (en prod conviene setearlo; en dev por defecto permite todo)
# CORS_ORIGIN=https://tu-frontend.com,https://otro.com

# Redis (opcional; si no se define, hay fallback en memoria)
REDIS_PASSWORD=
# Formato: redis://[:password]@host:port
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# Migraciones
# En dev/test: corre por defecto. En prod: solo si MIGRATIONS_AUTO_RUN=true
# MIGRATIONS_AUTO_RUN=true

# Audit retention (days). Si se setea, purga logs viejos al arrancar.
# AUDIT_RETENTION_DAYS=90

# Cleanup programado (tokens expirados, etc.)
CLEANUP_CRON=0 3 * * *

# Backups programados (PostgreSQL)
BACKUP_CRON=0 4 * * *
BACKUP_PATH=./backups

# Swagger
# En dev: habilitado por defecto. En prod: solo si SWAGGER_ENABLED=true
# SWAGGER_ENABLED=true
# SWAGGER_BASIC_USER=
# SWAGGER_BASIC_PASSWORD=

# Metrics (/metrics)
# En dev: habilitado por defecto. En prod: solo si METRICS_ENABLED=true y exige BasicAuth
# METRICS_ENABLED=true
# METRICS_BASIC_USER=
# METRICS_BASIC_PASSWORD=